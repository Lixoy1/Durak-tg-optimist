# Create a bot with @BotFather and paste its token here.
# Keep the real token private; never commit .env.
BOT_TOKEN=123456789:replace_with_real_token

# Public username without @, e.g. OptimistDurakBot. Configure /newapp in @BotFather.
BOT_USERNAME=
APP_SHORT_NAME=game

# HTTPS URL serving this Mini App. For Telegram end-to-end tests, use a public HTTPS URL/tunnel.
WEBAPP_URL=https://your-public-https-domain.example.com

# Port for HTTP, static Mini App files, health endpoint, and WebSocket /ws.
PORT=3000

# Exact browser origin(s), comma-separated. No path or trailing slash.
ALLOWED_ORIGINS=https://your-public-https-domain.example.com

NODE_ENV=development

# JSON file for persistent profiles, ratings and UI preferences.
# Set an absolute path in production if the working directory is not persistent.
STORAGE_FILE=.data/optimist-store.json
